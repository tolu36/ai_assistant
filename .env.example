MODEL_PROVIDER=fallback
MODEL_FALLBACK_PROVIDER=fallback
NEWS_SUMMARY_PROVIDER=off
CALENDAR_PROVIDER=mock
TIMEZONE=America/Toronto
SECRETS_PROVIDER=env
SSM_PARAMETER_PREFIX=/personal-ai-assistant/prod
APP_ACCESS_TOKEN=change_me_before_hosting

STORAGE_PROVIDER=sqlite
DYNAMODB_TABLE_NAME=personal-ai-assistant-state
DYNAMODB_USER_ID=default

SPORTS_INTERESTS=NBA,NFL
SPORTS_TEAMS=OKC Thunder,Toronto Raptors
FINANCE_WATCHLIST=XEQT.TO,VEQT.TO,VFV.TO,XIC.TO,ZAG.TO,CASH.TO,VTI,VOO,VT

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MORNING_BRIEF_FROM_EMAIL=your_email@example.com
MORNING_BRIEF_TO_EMAIL=your_email@example.com
MORNING_BRIEF_SUBJECT_PREFIX=Personal AI Assistant

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
