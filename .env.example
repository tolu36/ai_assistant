MODEL_PROVIDER=fallback
MODEL_FALLBACK_PROVIDER=fallback
NEWS_SUMMARY_PROVIDER=off
RSS_TIMEOUT_SECONDS=1.5
FINANCE_TICKER_FEED_LIMIT=4
OUTBOUND_HTTP_TRUST_ENV=false
CALENDAR_PROVIDER=mock
TIMEZONE=America/Toronto
SECRETS_PROVIDER=env
SSM_PARAMETER_PREFIX=/personal-ai-assistant/prod
APP_ACCESS_TOKEN=

STORAGE_PROVIDER=sqlite
DYNAMODB_TABLE_NAME=personal-ai-assistant-state
DYNAMODB_USER_ID=default

SPORTS_INTERESTS=NBA,NFL
SPORTS_TEAMS=OKC Thunder,Toronto Raptors
FINANCE_TOPICS=interest rates,Bank of Canada,inflation,housing,bond yields,global economy,employment,currency
FINANCE_WATCHLIST=XEQT.TO,VEQT.TO,VFV.TO,XIC.TO,ZAG.TO,CASH.TO,VTI,VOO,VT

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MORNING_BRIEF_FROM_EMAIL=your_email@example.com
MORNING_BRIEF_TO_EMAIL=your_email@example.com
MORNING_BRIEF_SUBJECT_PREFIX=Personal AI Assistant

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_RESPONSE_FORMAT=mp3
MISTRAL_TTS_VOICE_ID=gb_oliver_confident
MORNING_BRIEF_PREGENERATE_AUDIO=true
BRIEF_AUDIO_DIR=data/brief_audio
BRIEF_AUDIO_RETENTION_DAYS=7
BRIEF_AUDIO_OBJECT_BUCKET=
BRIEF_AUDIO_OBJECT_PREFIX=brief-audio
BRIEF_AUDIO_OBJECT_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
BRIEF_AUDIO_OBJECT_REGION=auto
BRIEF_AUDIO_OBJECT_ACCESS_KEY_ID=
BRIEF_AUDIO_OBJECT_SECRET_ACCESS_KEY=
